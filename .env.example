# Пример конфигурации. Скопируйте в .env и задайте значения.
# Файл .env в репозиторий не коммитится — секреты хранятся только в окружении.

# --- Общее -------------------------------------------------------------------
ENVIRONMENT=dev                  # dev | test | staging | prod
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json                  # json | text
TIMEZONE=Europe/Moscow
BASE_CURRENCY=RUB

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=tco
POSTGRES_PASSWORD=               # ОБЯЗАТЕЛЬНО задать
POSTGRES_DB=tco
# Публикация порта наружу; для закрытого стенда оставьте 127.0.0.1.
POSTGRES_PORT=127.0.0.1:5432
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# --- Redis / Celery ----------------------------------------------------------
REDIS_MAXMEMORY=512mb
# Broker и backend по умолчанию берутся из REDIS_URL (задается compose).
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=false   # true только для локальной отладки без брокера
CELERY_CONCURRENCY=4

# --- API / безопасность ------------------------------------------------------
API_PORT=8000
API_WORKERS=2
API_PREFIX=/api/v1
# OPEN — без авторизации (только временный режим, обязателен в ограничениях);
# LOCAL — локальный JWT; OIDC — внешний SSO.
DEPLOYMENT_MODE=LOCAL
JWT_SECRET=                      # ОБЯЗАТЕЛЬНО задать: openssl rand -hex 32
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=720
# В рабочем развертывании фронтенд идет через nginx на том же origin, поэтому
# CORS не задействован. Значения ниже нужны только для локальной разработки
# (Vite dev-server) и прямого обращения к API с другого хоста.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=240

# Пароли начальных учетных записей. Если не заданы — генерируются и
# однократно печатаются в лог при инициализации.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ANALYST_USERNAME=analyst
BOOTSTRAP_ANALYST_PASSWORD=
BOOTSTRAP_VIEWER_USERNAME=viewer
BOOTSTRAP_VIEWER_PASSWORD=

# --- UI ----------------------------------------------------------------------
UI_PORT=8080

# --- Коннекторы --------------------------------------------------------------
CONNECTOR_SOFT_TIMEOUT_SECONDS=20
CONNECTOR_HARD_TIMEOUT_SECONDS=30
CONNECTOR_MAX_RETRIES=2
CONNECTOR_CIRCUIT_BREAKER_FAILURES=5
CONNECTOR_CIRCUIT_BREAKER_COOLDOWN_SECONDS=900
ON_DEMAND_JOB_TIMEOUT_SECONDS=60

TUTU_ENABLED=true
TUTU_MCP_URL=https://mcp.tutu.ru/mcp

RZD_ENABLED=true
RZD_BASE_URL=https://ticket.rzd.ru

YANDEX_TRAVEL_BASE_URL=https://whitelabel.travel.yandex-net.ru/hotels
YANDEX_TRAVEL_TOKEN=

TRAVELLINE_AUTH_URL=https://partner.tlintegration.com/auth/token
TRAVELLINE_BASE_URL=https://partner.tlintegration.com/api
TRAVELLINE_CLIENT_ID=
TRAVELLINE_CLIENT_SECRET=

# Синтетический источник-песочница: позволяет прогнать весь конвейер без сети.
# В проде обязан быть false — его предложения всегда помечаются как синтетические.
SANDBOX_SOURCES_ENABLED=false

# --- Расчет и кэш ------------------------------------------------------------
RESULT_CACHE_ENABLED=true
RESULT_CACHE_TTL_MINUTES=45
# Интервал планового наблюдения. 1 — ежечасно (24 снимка в сутки на активный
# сценарий), 6 — четыре снимка в сутки. Задает и расписание Beat, и окно
# идемпотентности снимка. Увеличение частоты кратно увеличивает нагрузку на
# источники и объем raw-хранилища — см. docs/RUNBOOK.md.
SNAPSHOT_INTERVAL_HOURS=1
MONITORING_BATCH_CONCURRENCY=8
DEFAULT_BOOKING_HORIZON_DAYS=180

# --- Retention (0 — бессрочно) ----------------------------------------------
RETENTION_RAW_DAYS=45
RETENTION_HTML_DAYS=45
RETENTION_OFFERS_DAYS=90
RETENTION_SNAPSHOT_METADATA_DAYS=0
RETENTION_RUN_DAYS=0
RETENTION_EXPORT_DAYS=7

# --- Объектное хранилище (необязательно; по умолчанию файловое) --------------
# S3_ENDPOINT_URL=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
